# Python (no trailing slash: a .venv that links to a shared venv is ignored too)
.venv
__pycache__/
*.pyc

# The exported ExecuTorch program. create_ai_layer.py writes it next to the
# generated AI layer; the C array in ai_layer/model_pte.c is what gets built.
*.pte

# CMSIS-Toolbox build outputs. The per-context RTE/_<build>_<target>/ folders
# are generated; the layers' RTE/ configuration files are sources.
out/
tmp/
RTE/_*/
.cmsis/
*.cbuild-idx.yml
*.cbuild-pack.yml
*.cbuild-mlops.yml
# Written by hand for the traffic counter's Ethos-U55 (see the file).
!ai_layer_traffic/cmsis-executorch.cbuild-mlops.yml
*.update@*
.cmd.jlink

# Compiler-generated dependencies
*.d
# CMSIS Solution drop-ins are source files, despite the directory suffix.
!.vscode.d/

# Object files
*.o
*.ko
*.obj

# Linker output
*.elf
*.ilk
*.map
*.exp

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Executables and images
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# Regenerated by the CMSIS Solution / clangd extensions on every build, with
# absolute paths for the machine that built it -- so it cannot be committed in
# a portable form. Not committing it loses nothing: it is generated for you.
.clangd

# FVP output captured by CI and by the manual run in the README
fvp_stdout.log

# Editor config. The CMSIS Solution extension regenerates tasks.json,
# settings.json and cmsis.json; only the FVP run/debug wiring is kept: the
# model shim + its Dockerfile, and launch.json, whose Arm-FVP launch config is
# "manual" (see the comment in it). The leading negation overrides a global
# excludes file that ignores every .vscode directory.
!.vscode/
.vscode/*
!.vscode/fvp.sh
!.vscode/fvp.Dockerfile
!.vscode/launch.json

# SDS recordings of the rendered frames (documentation/npu-render.md); the
# stream metadata *.sds.yml next to them is source.
recordings/*.sds
recordings/*.index.txt
recordings/*.mp4
# The traffic counter's recordings (documentation/traffic-counter.md): the
# streams anywhere under recordings/, and every folder under recordings/traffic
# (camera recordings, video clips turned into CameraIn streams, their
# playbacks); recordings/traffic/*.sds.yml is source. The SDS extension's
# local state: its database and the SDSIO server configuration it writes.
recordings/**/*.sds
recordings/traffic/*/
.sdsstudio
*.sdsio.yml

# The Quake source (GPL) is fetched by quake/fetch_quake.py, never committed;
# neither is the game data.
quake/upstream/
quake/data/
*.pak

# The cat detector: the test image is generated from a photo that is not ours
# to redistribute (yolo/make_test_image.py), and model/yolo.py caches the
# YOLO26n weights and the COCO128 calibration images next to itself.
yolo/test_image.c
yolo/test_image.h
traffic/test_image.c
traffic/test_image.h
model/.cache
# Frames ffmpeg extracts for the "SDS: video to CameraIn stream" task.
.sds_frames/
