{
    "version": "0.2.0",
    "configurations": [
        {
            // Generated by the CMSIS Solution extension from its Arm-FVP adapter
            // template, then switched to "manual" because two "target" fields
            // differ from the generated ones and would be lost on regeneration:
            //   "port": ""  +  "serverPortRegExp"  -- with a port set, the debug
            //     adapter connects 0 ms after spawning the model, before the
            //     GDBServer plugin listens; blank port makes it wait for the
            //     "GDBServer: Listening ... port=3333" banner instead.
            //   "portDetectionTimeout" -- the first run on macOS builds the
            //     Docker image (see .vscode/fvp.sh).
            // and one model option: GDBServer.shutdown_on_disconnect=1, or the
            // model (its container on macOS) outlives the debug session once
            // the application has exited.
            // To re-sync after changing target-type or build-type: set
            // "updateConfiguration" to "auto", run "CMSIS: Update Debug Tasks
            // and Launch Configurations", then re-apply the fields above and
            // set it back to "manual".
            "name": "Arm-FVP@GDB (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/traffic/SSE-300-U55/Release/traffic.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "tbreak main"
            ],
            "target": {
                "server": "${workspaceFolder}/.vscode/fvp.sh",
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${env:AVH_FVP_PLUGINS}/GDBServer.so",
                    "-C",
                    "GDBServer.port=3333",
                    "-C",
                    "GDBServer.shutdown_on_disconnect=1",
                    "-f",
                    "board/Corstone-300/fvp_config.txt",
                    "--simlimit",
                    "600",
                    "-a",
                    "out/traffic/SSE-300-U55/Release/traffic.hex"
                ],
                "port": "",
                "serverPortRegExp": "GDBServer: Listening .*port=([0-9]+)",
                "portDetectionTimeout": 300000
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "M55_HP JLink (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/traffic/AppKit-E7/Release/traffic.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "preLaunchTask": "CMSIS Load",
            "initCommands": [
                "monitor reset 0",
                "tbreak main",
                ""
            ],
            "customResetCommands": [
                "monitor reset 0",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "JLinkGDBServerCL",
                "serverParameters": [
                    "-device",
                    "AE722F80F55D5LS_M55_HP",
                    "-endian",
                    "little",
                    "-if",
                    "swd",
                    "-speed",
                    "4000",
                    "-halt",
                    "-noir",
                    "-vd",
                    "-nogui",
                    "-localhostonly",
                    "-silent",
                    "-port",
                    "3333",
                    "-TelnetPort",
                    "4444"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "M55_HP JLink (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/traffic/AppKit-E7/Release/traffic.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "initCommands": [
                ""
            ],
            "customResetCommands": [
                "monitor reset 0",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "M55_HE JLink (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "initCommands": [
                ""
            ],
            "customResetCommands": [
                "monitor reset 0",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "JLinkGDBServerCL",
                "serverParameters": [
                    "-device",
                    "AE722F80F55D5LS_M55_HE",
                    "-endian",
                    "little",
                    "-if",
                    "swd",
                    "-speed",
                    "4000",
                    "-halt",
                    "-noir",
                    "-vd",
                    "-nogui",
                    "-localhostonly",
                    "-silent",
                    "-port",
                    "3334",
                    "-TelnetPort",
                    "4445"
                ],
                "port": "3334"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}
